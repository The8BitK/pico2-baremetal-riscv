.ifndef	_BOOT_PICOBIN_H
.set	_BOOT_PICOBIN_H, 1

#
# Constants for PICOBIN format
# 

# these are designed to not look like (likely) 16/32-bit ARM or RISC-V instructions or look like valid pointers
.equ	PICOBIN_BLOCK_MARKER_START, 0xffffded3
.equ	PICOBIN_BLOCK_MARKER_END, 0xab123579

.equ	PICOBIN_MAX_BLOCK_SIZE, 0x280
.equ	PICOBIN_MAX_IMAGE_DEF_BLOCK_SIZE, 0x180
.equ	PICOBIN_MAX_PARTITION_TABLE_BLOCK_SIZE, 0x280

# note bit 6 is used to make parity even
.equ	PICOBIN_BLOCK_ITEM_1BS_NEXT_BLOCK_OFFSET, 0x41
.equ	PICOBIN_BLOCK_ITEM_1BS_IMAGE_TYPE, 0x42
.equ	PICOBIN_BLOCK_ITEM_1BS_VECTOR_TABLE, 0x03
.equ	PICOBIN_BLOCK_ITEM_1BS_ENTRY_POINT, 0x44
.equ	PICOBIN_BLOCK_ITEM_1BS_ROLLING_WINDOW_DELTA, 0x05
.equ	PICOBIN_BLOCK_ITEM_LOAD_MAP, 0x06
.equ	PICOBIN_BLOCK_ITEM_1BS_HASH_DEF, 0x47
.equ	PICOBIN_BLOCK_ITEM_1BS_VERSION, 0x48
.equ	PICOBIN_BLOCK_ITEM_SIGNATURE, 0x09
.equ	PICOBIN_BLOCK_ITEM_PARTITION_TABLE, 0x0a
.equ	PICOBIN_BLOCK_ITEM_HASH_VALUE, 0x4b
.equ	PICOBIN_BLOCK_ITEM_SALT, 0x0c

.equ	PICOBIN_BLOCK_ITEM_2BS_IGNORED, 0x80 | 0x7e
.equ	PICOBIN_BLOCK_ITEM_2BS_LAST, 0x80 | 0x7f

# ----

#define _PICOBIN_INDEX_TO_BITS(y, x) (y ## x << y ## _LSB)
#define PICOBIN_INDEX_TO_BITS(y, x) (y ## _ ## x << y ## _LSB)

.equ	PICOBIN_IMAGE_TYPE_IMAGE_TYPE_LSB, 0
.equ	PICOBIN_IMAGE_TYPE_IMAGE_TYPE_BITS, 0x000f
.equ	PICOBIN_IMAGE_TYPE_IMAGE_TYPE_INVALID, 0x0
.equ	PICOBIN_IMAGE_TYPE_IMAGE_TYPE_EXE, 0x1
.equ	PICOBIN_IMAGE_TYPE_IMAGE_TYPE_DATA, 0x2

#define PICOBIN_IMAGE_TYPE_IMAGE_TYPE_AS_BITS(x) _PICOBIN_INDEX_TO_BITS(PICOBIN_IMAGE_TYPE_IMAGE_TYPE, _ ## x)

.equ	PICOBIN_IMAGE_TYPE_EXE_SECURITY_LSB, 4
.equ	PICOBIN_IMAGE_TYPE_EXE_SECURITY_BITS, 0x0030
.equ	PICOBIN_IMAGE_TYPE_EXE_SECURITY_UNSPECIFIED, 0x0
.equ	PICOBIN_IMAGE_TYPE_EXE_SECURITY_NS, 0x1
.equ	PICOBIN_IMAGE_TYPE_EXE_SECURITY_S, 0x2

#define PICOBIN_IMAGE_TYPE_EXE_SECURITY_AS_BITS(x) _PICOBIN_INDEX_TO_BITS(PICOBIN_IMAGE_TYPE_EXE_SECURITY, _ ## x)

.equ	PICOBIN_IMAGE_TYPE_EXE_CPU_LSB, 8
.equ	PICOBIN_IMAGE_TYPE_EXE_CPU_BITS, 0x0700
.equ	PICOBIN_IMAGE_TYPE_EXE_CPU_ARM, 0
.equ	PICOBIN_IMAGE_TYPE_EXE_CPU_RISCV, 1
.equ	PICOBIN_IMAGE_TYPE_EXE_CPU_VARMULET, 2

#define PICOBIN_IMAGE_TYPE_EXE_CPU_AS_BITS(x) _PICOBIN_INDEX_TO_BITS(PICOBIN_IMAGE_TYPE_EXE_CPU, _ ## x)

.equ	PICOBIN_IMAGE_TYPE_EXE_CHIP_LSB, 12
.equ	PICOBIN_IMAGE_TYPE_EXE_CHIP_BITS, 0x7000
.equ	PICOBIN_IMAGE_TYPE_EXE_CHIP_RP2040, 0
.equ	PICOBIN_IMAGE_TYPE_EXE_CHIP_RP2350, 1

#define PICOBIN_IMAGE_TYPE_EXE_CHIP_AS_BITS(x) _PICOBIN_INDEX_TO_BITS(PICOBIN_IMAGE_TYPE_EXE_CHIP, _ ## x)

.equ	PICOBIN_IMAGE_TYPE_EXE_TBYB_BITS, 0x8000

# todo assert no overlap ^

.equ	PICOBIN_PARTITION_PERMISSIONS_LSB, 26
.equ	PICOBIN_PARTITION_PERMISSIONS_BITS, 0xfc000000

.equ	PICOBIN_PARTITION_PERMISSION_S_R_BITS, 0x04000000
.equ	PICOBIN_PARTITION_PERMISSION_S_W_BITS, 0x08000000
.equ	PICOBIN_PARTITION_PERMISSION_NS_R_BITS, 0x10000000
.equ	PICOBIN_PARTITION_PERMISSION_NS_W_BITS, 0x20000000
.equ	PICOBIN_PARTITION_PERMISSION_NSBOOT_R_BITS, 0x40000000
.equ	PICOBIN_PARTITION_PERMISSION_NSBOOT_W_BITS, 0x80000000

.equ	PICOBIN_PARTITION_LOCATION_FIRST_SECTOR_LSB, 0
.equ	PICOBIN_PARTITION_LOCATION_FIRST_SECTOR_BITS, 0x00001fff
.equ	PICOBIN_PARTITION_LOCATION_LAST_SECTOR_LSB, 13
.equ	PICOBIN_PARTITION_LOCATION_LAST_SECTOR_BITS, 0x03ffe000

.equ	PICOBIN_PARTITION_FLAGS_HAS_ID_BITS, 0x00000001
.equ	PICOBIN_PARTITION_FLAGS_LINK_TYPE_LSB, 1
.equ	PICOBIN_PARTITION_FLAGS_LINK_TYPE_BITS, 0x00000006
.equ	PICOBIN_PARTITION_FLAGS_LINK_VALUE_LSB, 3
.equ	PICOBIN_PARTITION_FLAGS_LINK_VALUE_BITS, 0x00000078

.equ	PICOBIN_PARTITION_MAX_EXTRA_FAMILIES, 3
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_NUM_EXTRA_FAMILIES_LSB, 7
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_NUM_EXTRA_FAMILIES_BITS, 0x00000180
# these are an optimization when booting in either ARM or RISC-V, to avoid looking at partitions
# which are known not to contain the right sort of binary, OR as a way to prevent
# auto-architecture-switch. NOTE: the first partition that can be booted, will be,
# so if you have a RISC-V binary in the first partition, and auto-arhcitecture-switch enabled, then
# even if booting under ARM, with an ARM binary in a later partition, the RISC-V binary
# will be booted by default; setting PICOBIN_PARTITION_FLAGS_IGNORED_DURING_ARM_BOOT_BITS
# on the partition, will have the RISC-V binary containing partition ignored under ARM
# boot
.equ	PICOBIN_PARTITION_FLAGS_IGNORED_DURING_ARM_BOOT_BITS, 0x00000200
.equ	PICOBIN_PARTITION_FLAGS_IGNORED_DURING_RISCV_BOOT_BITS, 0x00000400
.equ	PICOBIN_PARTITION_FLAGS_UF2_DOWNLOAD_AB_NON_BOOTABLE_OWNER_AFFINITY, 0x00000800
.equ	PICOBIN_PARTITION_FLAGS_HAS_NAME_BITS, 0x00001000
.equ	PICOBIN_PARTITION_FLAGS_UF2_DOWNLOAD_NO_REBOOT_BITS, 0x00002000
# we have a bit for each well known family-id .. note we expect there to be more in the future with new chips,
# but we have plenty of space for now.
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_DEFAULT_FAMILIES_LSB, 14
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_DEFAULT_FAMILY_RP2040_BITS, 0x00004000
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_DEFAULT_FAMILY_ABSOLUTE_BITS, 0x00008000
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_DEFAULT_FAMILY_DATA_BITS, 0x00010000
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_DEFAULT_FAMILY_RP2350_ARM_S_BITS, 0x00020000
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_DEFAULT_FAMILY_RP2350_RISCV_BITS, 0x00040000
.equ	PICOBIN_PARTITION_FLAGS_ACCEPTS_DEFAULT_FAMILY_RP2350_ARM_NS_BITS, 0x00080000

.equ	PICOBIN_PARTITION_FLAGS_LINK_TYPE_NONE, 0
.equ	PICOBIN_PARTITION_FLAGS_LINK_TYPE_A_PARTITION, 1
.equ	PICOBIN_PARTITION_FLAGS_LINK_TYPE_OWNER_PARTITION, 2

#define PICOBIN_PARTITION_FLAGS_LINK_TYPE_AS_BITS(x) _PICOBIN_INDEX_TO_BITS(PICOBIN_PARTITION_FLAGS_LINK_TYPE, _ ## x)

.equ	PICOBIN_HASH_SHA256, 0x01
.equ	PICOBIN_SIGNATURE_SECP256K1, 0x01

.endif # _BOOT_PICOBIN_H
